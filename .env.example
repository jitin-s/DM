# ====================================================================
# DEVILMOTION ENVIRONMENT CONFIGURATION TEMPLATE
# For local development: copy to .env
# For Vercel deployment: add these in Project Settings > Environment Variables
# ====================================================================

# --------------------------------------------------------------------
# 1. CRITICAL & MANDATORY VARIABLES FOR VERCEL
# --------------------------------------------------------------------

# JWT Security Key (Generate a random 64-character hex string)
AUTH_SECRET="devilmotion_super_secure_jwt_secret_key_change_me_2026"

# Node Environment ('production' on Vercel)
NODE_ENV="production"

# Database URL
# In Vercel serverless, SQLite runs automatically from /tmp/dev.db.
# Or provide your external PostgreSQL / Turso / Supabase / Neon connection URL:
DATABASE_URL="file:./dev.db?connection_limit=1&timeout=20000"

# --------------------------------------------------------------------
# 2. STREAMING & EMBED HOSTS (Pre-configured for VidWave)
# --------------------------------------------------------------------
VIDWAVE_EMBED_HOST="https://embed.vidwave.sbs"
MEGAPLAY_BASE_URL="https://megaplay.buzz"
ANIKOTO_API_BASE_URL="https://anikotoapi.site"

# --------------------------------------------------------------------
# 3. METADATA PROVIDERS
# --------------------------------------------------------------------
ANILIST_API_URL="https://graphql.anilist.co"

# MyAnimeList Official Client ID (Optional for extended rate limits)
MAL_CLIENT_ID=""

# --------------------------------------------------------------------
# 4. ADMIN & SECURITY CONFIGURATION
# --------------------------------------------------------------------
DEFAULT_ADMIN_PASSWORD="DevilMotionAdmin2026!"
JWT_EXPIRES_IN="7d"

# Frontend URL (Optional on Vercel - automatically matches your Vercel URL)
FRONTEND_URL="https://your-project.vercel.app"
